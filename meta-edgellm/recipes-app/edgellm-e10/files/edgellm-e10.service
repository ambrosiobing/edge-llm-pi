[Unit]
Description=edge-llm-pi e10, the MCC 118 voltage event labeller over 2 ms windows
Documentation=https://github.com/ambrosiobing/edge-llm-pi
# The HAT is a user-space library over SPI0; there is no kernel device unit to order
# after, so the condition is the device node the library opens.
ConditionPathExists=/dev/spidev0.0
After=multi-user.target

[Service]
Type=simple
# Live: the project's main forks the libdaqhats capture and feeds the shared loop
# through a pipe; --live mcc118 <address>:<channel>:<window_ms>. The run ends on stop.
ExecStart=/usr/bin/edgellm-e10 --project e10 \
    --live mcc118 0:0:2 \
    --model /usr/share/edgellm/models/qwen2.5-0.5b-instruct-q4_k_m.gguf \
    --grammar /usr/share/edgellm/e10/grammar.gbnf \
    --prompt /usr/share/edgellm/e10/prompt.txt \
    --log /var/lib/edgellm/e10.csv \
    --threads 4 --n-predict 8 --state /run/edgellm/e10.state
StateDirectory=edgellm
RuntimeDirectory=edgellm
# A HAT error ends the capture with exit 1; the scan is stopped and cleaned up first,
# so a restart meets an idle board.
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
